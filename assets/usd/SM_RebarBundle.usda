    def Scope "_materials"
    {
        def Material "MAT_WoodDark" (
            prepend apiSchemas = ["ColorSpaceAPI"]
        )
        {
            uniform token colorSpace:name = "lin_rec709_scene"
            token outputs:surface.connect = </root/_materials/MAT_WoodDark/Principled_BSDF.outputs:surface>
            custom string userProperties:blender:data_name = "MAT_WoodDark"

            def Shader "Principled_BSDF"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0
                float inputs:clearcoatRoughness = 0.03
                color3f inputs:diffuseColor = (0.5, 0.34, 0.18)
                float inputs:ior = 1.5
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.8
                float inputs:specular = 0.5
                token outputs:surface
            }
        }

        def Material "MAT_Rebar" (
            prepend apiSchemas = ["ColorSpaceAPI"]
        )
        {
            uniform token colorSpace:name = "lin_rec709_scene"
            token outputs:surface.connect = </root/_materials/MAT_Rebar/Principled_BSDF.outputs:surface>
            custom string userProperties:blender:data_name = "MAT_Rebar"

            def Shader "Principled_BSDF"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0
                float inputs:clearcoatRoughness = 0.03
                color3f inputs:diffuseColor = (0.16, 0.1, 0.07)
                float inputs:ior = 1.5
                float inputs:metallic = 0.8
                float inputs:opacity = 1
                float inputs:roughness = 0.75
                float inputs:specular = 0.5
                token outputs:surface
            }
        }

        def Material "MAT_TieWire" (
            prepend apiSchemas = ["ColorSpaceAPI"]
        )
        {
            uniform token colorSpace:name = "lin_rec709_scene"
            token outputs:surface.connect = </root/_materials/MAT_TieWire/Principled_BSDF.outputs:surface>
            custom string userProperties:blender:data_name = "MAT_TieWire"

            def Shader "Principled_BSDF"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0
                float inputs:clearcoatRoughness = 0.03
                color3f inputs:diffuseColor = (0.25, 0.25, 0.26)
                float inputs:ior = 1.5
                float inputs:metallic = 0.9
                float inputs:opacity = 1
                float inputs:roughness = 0.5
                float inputs:specular = 0.5
                token outputs:surface
            }
        }
    }
