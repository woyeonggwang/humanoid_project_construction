    def Scope "_materials"
    {
        def Material "MAT_PalletWood" (
            prepend apiSchemas = ["ColorSpaceAPI"]
        )
        {
            uniform token colorSpace:name = "lin_rec709_scene"
            token outputs:surface.connect = </root/_materials/MAT_PalletWood/Principled_BSDF.outputs:surface>
            custom string userProperties:blender:data_name = "MAT_PalletWood"

            def Shader "Principled_BSDF"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0
                float inputs:clearcoatRoughness = 0.03
                color3f inputs:diffuseColor = (0.45, 0.35, 0.22)
                float inputs:ior = 1.5
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.85
                float inputs:specular = 0.5
                token outputs:surface
            }
        }

        def Material "MAT_CementBag" (
            prepend apiSchemas = ["ColorSpaceAPI"]
        )
        {
            uniform token colorSpace:name = "lin_rec709_scene"
            token outputs:surface.connect = </root/_materials/MAT_CementBag/Principled_BSDF.outputs:surface>
            custom string userProperties:blender:data_name = "MAT_CementBag"

            def Shader "Principled_BSDF"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0
                float inputs:clearcoatRoughness = 0.03
                color3f inputs:diffuseColor = (0.62, 0.56, 0.44)
                float inputs:ior = 1.5
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.8
                float inputs:specular = 0.5
                token outputs:surface
            }
        }
    }
