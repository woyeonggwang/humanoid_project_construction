            prepend apiSchemas = ["ColorSpaceAPI"]
        )
        {
            uniform token colorSpace:name = "lin_rec709_scene"
            token outputs:surface.connect = </root/_materials/MAT_GalvSteel/Principled_BSDF.outputs:surface>
