    }

    def Scope "_materials"
    {
        def Material "MAT_Dirt" (
            prepend apiSchemas = ["ColorSpaceAPI"]
        )
        {
            uniform token colorSpace:name = "lin_rec709_scene"
            token outputs:surface.connect = </root/_materials/MAT_Dirt/Principled_BSDF.outputs:surface>
            custom string userProperties:blender:data_name = "MAT_Dirt"

            def Shader "Principled_BSDF"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0
                float inputs:clearcoatRoughness = 0.03
                color3f inputs:diffuseColor = (0.3, 0.21, 0.13)
                float inputs:ior = 1.5
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.95
                float inputs:specular = 0.5
                token outputs:surface
            }
        }

        def Material "MAT_DirtLight" (
            prepend apiSchemas = ["ColorSpaceAPI"]
        )
        {
            uniform token colorSpace:name = "lin_rec709_scene"
            token outputs:surface.connect = </root/_materials/MAT_DirtLight/Principled_BSDF.outputs:surface>
            custom string userProperties:blender:data_name = "MAT_DirtLight"

            def Shader "Principled_BSDF"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0
                float inputs:clearcoatRoughness = 0.03
                color3f inputs:diffuseColor = (0.38, 0.28, 0.18)
                float inputs:ior = 1.5
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.95
                float inputs:specular = 0.5
                token outputs:surface
            }
        }

        def Material "MAT_DirtDark" (
            prepend apiSchemas = ["ColorSpaceAPI"]
        )
        {
            uniform token colorSpace:name = "lin_rec709_scene"
            token outputs:surface.connect = </root/_materials/MAT_DirtDark/Principled_BSDF.outputs:surface>
            custom string userProperties:blender:data_name = "MAT_DirtDark"

            def Shader "Principled_BSDF"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0
                float inputs:clearcoatRoughness = 0.03
                color3f inputs:diffuseColor = (0.22, 0.15, 0.09)
                float inputs:ior = 1.5
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.95
                float inputs:specular = 0.5
                token outputs:surface
            }
        }
    }
